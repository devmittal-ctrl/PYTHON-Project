# turtle race 
import turtle
import random
screen=turtle.Screen()
screen.bgcolor("black")
screen.setup(width=500,height=500)
screen.title("Turtle Race")
user=screen.textinput(title="Welcome To Race",prompt="Make a bet on who win!")
color_turtle=["red","blue","white","green","yellow","orange","purple","brown"]
y_pos=[-100,-70,-40,-10,20,50,80,110]
all_turtle=[]

# creation of all turtles 
for d in range(0,8):
    tom=turtle.Turtle()
    tom.shape("turtle")
    tom.color(color_turtle[d])
    tom.penup()
    tom.goto(x=-230,y=y_pos[d])
    tom.pendown
    all_turtle.append(tom)

# race condition of turtle:
game=True
while game:
    for t in all_turtle:
        dis=random.randint(1,10)
        t.forward(dis)
        if t.xcor()==230:
            game=False
            break

screen.exitonclick()
