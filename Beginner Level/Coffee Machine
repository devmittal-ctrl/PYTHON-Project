    total+=int(input("how many dimes "))*0.1
    total+=int(input("how many pennis "))*0.01
    total+=int(input("how many nickels "))*0.05
    return total
# reduction to resourecse that machine have 
def depletion_of_resources(use):
    for items in use:
        resource[items]-=use[items]
