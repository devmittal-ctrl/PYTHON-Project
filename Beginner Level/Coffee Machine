# checking for the sufficient resources if we have to process 
def check_resources(for_use):
    for item in for_use:
        if for_use[item]>resource[item]:
            print("Soory we can't process your order ")
            return False
    print("Yes, your order is placed successfully 😇")
    return True
#  processing the coins 
def process_coins():
